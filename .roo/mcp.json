{
	"mcpServers": {
		"anklebreaker-unity-mcp": {
			"command": "npx",
			"args": [
				"-y",
				"anklebreaker-unity-mcp@latest"
			],
			"env": {
				"UNITY_HUB_PATH": "C:\\Program Files\\Unity Hub\\Unity Hub.exe",
				"UNITY_BRIDGE_PORT": "7890"
			},
			"disabledTools": [
				"unity_script_create",
				"unity_script_read",
				"unity_script_update",
				"unity_hub_list_editors",
				"unity_hub_available_releases",
				"unity_hub_install_editor",
